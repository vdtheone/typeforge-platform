## 🗃️ Database Schema

```mermaid
erDiagram
    User ||--o{ Result : creates
    User ||--o{ UserProfile : has
    User ||--o{ WordList : creates
    User ||--o{ Theme : creates
    User ||--o{ AnalyticsSnapshot : has
    
    WordList ||--o{ Result : "used in"
    Language ||--o{ WordList : contains
    
    Result ||--o{ TypingSession : generates
    
    User {
        int id PK
        string email UK
        string username UK
        string password
        boolean is_active
        datetime date_joined
    }
    
    UserProfile {
        int id PK
        int user_id FK
        string display_name
        string avatar_url
        string bio
        string country
        int total_tests
        float best_wpm
        float avg_wpm
        int xp
        int level
        json preferences
    }
    
    Result {
        int id PK
        int user_id FK
        int wordlist_id FK
        float wpm
        float raw_wpm
        float accuracy
        float consistency
        string mode
        int duration
        string language
        json keystrokes
        json char_log
        boolean is_personal_best
        boolean is_flagged
        datetime created_at
    }
    
    WordList {
        int id PK
        int creator_id FK
        int language_id FK
        string name
        string slug
        text words_json
        string difficulty
        boolean is_public
        boolean is_default
        int word_count
    }
    
    Language {
        int id PK
        string name
        string code
        boolean is_active
    }
    
    Theme {
        int id PK
        int creator_id FK
        string name
        string slug
        json css_variables
        boolean is_public
        boolean is_default
        int likes_count
    }
    
    AnalyticsSnapshot {
        int id PK
        int user_id FK
        string period_type
        date period_start
        float avg_wpm
        float avg_accuracy
        float avg_consistency
        int total_tests
        json weak_keys
        json metrics
    }
    
    TypingSession {
        int id PK
        int result_id FK
        json keystroke_log
        json error_positions
        json timing_data
        float burst_speed_max
        float burst_speed_avg
    }
```

