# =============================================================================
# TypeForge Platform — Environment Configuration
# =============================================================================
# Copy this file to .env and fill in the values

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-random-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_SETTINGS_MODULE=config.settings.development

# --- Database ---
DATABASE_URL=postgres://typeforge:typeforge@localhost:5432/typeforge_db
DB_NAME=typeforge_db
DB_USER=typeforge
DB_PASSWORD=typeforge
DB_HOST=localhost
DB_PORT=5432

# --- Redis ---
REDIS_URL=redis://localhost:6379/0
CACHE_REDIS_URL=redis://localhost:6379/1

# --- Celery ---
CELERY_BROKER_URL=redis://localhost:6379/2

# --- CORS ---
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# --- OAuth (Google) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- OAuth (GitHub) ---
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Email ---
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# --- AWS S3 / Media Storage (optional) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=

# --- Sentry (optional) ---
SENTRY_DSN=
